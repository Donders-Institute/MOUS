 #==============================================================#
 # GETSELECTION                                                 #
 #==============================================================#
 # DESCRIPTION:                                                 #
 #                                                              #
 #   Get and classify selection input                           #
 #                                                              #
 # SYNTAX:                                                      #
 #                                                              #
 #   int Out = getselection (Halfwidth,NumLocations,Positions,  #
 #                           ActiveCentre,xMouse,yMouse);       #
 #                                                              #
 # OPTION:                                                      #
 #                                                              #
 #   HalfWidth    = Halfwidth of selection area                 #
 #   NumPositions = Number of selection positions               #
 #   Positions    = Selection positions x,y-coordinates         #
 #   ActiveCentre = Active centre position to jump reponse      #
 #   xMouse       = Mouse x-coordinate                          #
 #   yMouse       = Mouse y-coordinate                          #
 #                                                              #
 # EXAMPLE:                                                     #
 #                                                              #
 #   int  Halfwidth    = 25;                                    # Halfwidth of selection area
 #   int  NumPositions = 10;                                    # Number of selection positions
 #   array<int> Positions[NumPositions][2] = {                  # Selection positions x,y-coordinates
 #     {   0, 200 },{ 118, 162 },{ 190,  62 },{ 190,-62 },      #   POS1-4  {X, Y}
 #     { 118,-162 },{   0,-200 },{-118,-162 },{-190,-62 },      #   POS5-8  {X, Y}
 #     {-190,  62 },{-118, 162 }                                #   POS9-10 {X, Y}
 #   };                                                         # 
 #   bool ActiveCentre = true;                                  # Active centre position to jump reponse
 #   int  xMouse       = 20;                                    # Mouse x-coordinate
 #   int  yMouse       = 40;                                    # Mouse y-coordinate
 #   int Out = getselection(Halfwidth,NumPositions,Positions,   #
 #                          ActiveCentre,xMouse,yMouse);        #
 #                                                              #
 # DEPENDENCIES:                                                #
 #                                                              #
 #   No dependencies                                            #
 #                                                              #
 # OBJECTS:                                                     #
 #                                                              #
 #   No objects                                                 #
 #                                                              #
 # Last version 28-Oct-2008 12:55:25, Christian Forkstam        #
 #==============================================================#
 sub int getselection (                                         # ---INPUT ARGUMENT(S)
     int           HalfwidthF,                                  #|Halfwidth of selection area
     int           NumPositionsF,                               #|Number of selection positions
     array<int,2>& PositionsF,                                  #|Selection positions x,y-coordinates
     bool          ActiveCentreF,                               #|Active centre position to jump reponse
     int           xMouseF,                                     #|Mouse x-coordinate
     int           yMouseF                                      #|Mouse y-coordinate
 ) begin                                                        # ---
 if                                                             #|
   Debug                                                        #|
 then                                                           #|
   term.print("RUNNING: GETSELECTION\n");                       #|
 end;                                                           #|
 #--------------------------------------------------------------#|
                                                                #|
   loop                                                         #|Loop over target locations
     int Pos = 1                                                #|
   until                                                        #|
     Pos > NumPositionsF                                        #|
   begin                                                        #|
     if                                                         #|IF MOUSE CLICK IS INSIDE ANY LOCATION
       xMouseF >= PositionsF[Pos][1] - HalfwidthF &&            #|Left of x-position
       xMouseF <= PositionsF[Pos][1] + HalfwidthF &&            #|Right of x-position
       yMouseF >= PositionsF[Pos][2] - HalfwidthF &&            #|Left of y-position
       yMouseF <= PositionsF[Pos][2] + HalfwidthF               #|Right of y-position
     then                                                       #|
       return Pos                                               #|Return selected picture part
     end;                                                       #|
     Pos = Pos + 1                                              #|Update Pos
   end;                                                         #|
                                                                #|
   if                                                           #|
     ActiveCentreF == true                                      #|
   then                                                         #|
     if                                                         #|IF MOUSE CLICK IS INSIDE ANY LOCATION
       xMouseF >= 0 - HalfwidthF &&                             #|Left of x-position
       xMouseF <= 0 + HalfwidthF &&                             #|Right of x-position
       yMouseF >= 0 - HalfwidthF &&                             #|Left of y-position
       yMouseF <= 0 + HalfwidthF                                #|Right of y-position
     then                                                       #|
       return NumPositionsF + 1                                 #|Return selected centre position
     end;                                                       #|
   end;                                                         #|
                                                                #|
   return 0                                                     #|RETURN 0 IF MOUSE CLICK NOT INSIDE ANY LOCATION
                                                                #|
 end;                                                           # ---
