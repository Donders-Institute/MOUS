 #==============================================================#
 # PRESENTTRIAL                                                 #
 #==============================================================#
 # DESCRIPTION:                                                 #
 #                                                              #
 #   Present trial screen                                       #
 #                                                              #
 # SYNTAX:                                                      #
 #                                                              #
 #   presenttrial (Duration,ResponseType,TextStr,FontSize,      #
 #                 yPosition,EventCode,PortCode,SendCodeF)      #
 #                                                              #
 # OPTION:                                                      #
 #                                                              #
 #   Duration     = Duration (ms)                               #
 #   ResponseType = Response type {"FirstResponse"|             #
 #         "FixedDuration"|"CorrectResponse"|"SpecificResponse"}#
 #   TextStr      = Text string or nothing ("Keep")             #
 #   FontSize     = Font size                                   #
 #   yPosition    = Object position y-coordinate                #
 #   EventCode    = Event log code                              #
 #   PortCode     = Port code                                   #
 #   SendCode     = Send code {true|false}                      #
 #                                                              #
 # EXAMPLE:                                                     #
 #                                                              #
 #   Duration     = 1000;                                       # Set duration to 1000 ms
 #   ResponseType = "FixedDuration";                            # Collect but ignore responses
 #   TextStr      = "FixedDuration";                            # Set text string
 #   FontSize     = 20;                                         # Set font size to 20
 #   yPosition    = 150;                                        # Set object position y-coordinate to 150
 #   EventCode    = "Log";                                      # Set event log code to "Log"
 #   PortCode     = "20";                                       # Set port code to 20
 #   SendCode     = true                                        # Send code
 #   presenttrial (Duration,ResponseType,TextStr,FontSize,      #
 #                 yPosition,EventCode,PortCode,SendCode)       # PRESENT TRIAL WITH FIXED DURATION
 #                                                              #
 #   ResponseType = "FirstResponse";                            # Collect but ignore responses
 #   TextStr      = "FirstResponse";                            # Set text string
 #   presenttrial (Duration,ResponseType,TextStr,FontSize,      #
 #                 yPosition,EventCode,PortCode,SendCode)       # PRESENT TRIAL AND AWAIT ANY RESPONSE
 #                                                              #
 #   ResponseType = "CorrectResponse";                          # Collect but ignore responses
 #   TextStr      = "CorrectResponse";                          # Set text string
 #   setresponse(3,0,0);                                        # Set target button 3 as correct response
 #   presenttrial (Duration,ResponseType,TextStr,FontSize,      #
 #                 yPosition,EventCode,PortCode,SendCode)       # PRESENT TRIAL AND AWAIT CORRECT RESPONSE
 #                                                              #
 # DEPENDENCIES:                                                #
 #                                                              #
 #   GETTEXT                                                    #
 #   GETPICTURE                                                 #
 #   GETTRIAL                                                   #
 #                                                              #
 # OBJECTS:                                                     #
 #   Text object Text                                           #
 #   Picture object Picture                                     #
 #   Trial object Trial                                         #
 #                                                              #
 # 27-Mar-2009 18:53:00, CF                                     #
 #  * Included handle for StimFirstResponse                     #
 # 20-Mar-2009 19:33:00, CF                                     #
 #  * Included else condition for set_type                      #
 # Update 6-Nov-2008 10:33:00, Christian Forkstam               #
 #  * Included target button for next trial in selfpaced mode   #
 #==============================================================#
 sub presenttrial (                                             # ---INPUT ARGUMENT(S)
     int    DurationF,                                          #|Duration (ms)
     string ResponseTypeF,                                      #|Response type {"FirstResponse"|"FixedDuration"|"CorrectResponse"|"SpecificResponse"}
     string TextStrF,                                           #|Text string {String|"Keep"}
     int    FontSizeF,                                          #|Font size
     int    yPositionF,                                         #|Object position y-coordinate
     string EventCodeF,                                         #|Event log code
     string PortCodeF,                                          #|Port code
     bool   SendCodeF                                           #|Send code {true|false}
 ) begin                                                        # ---
 if                                                             #|
   Debug                                                        #|
 then                                                           #|
   term.print("RUNNING: PRESENTTRIAL\n");                       #|
 end;                                                           #|
 #--------------------------------------------------------------#|
                                                                #|
   trial   TrialF = gettrial(Trial);                            #|trial TrialF = Trial
   picture PictureF = getpicture(Picture);                      #|picture PictureF = Picture
   text    TextF = gettext(Texts[1]);                           #|text TextF = Texts[1]
   PictureF.add_part( TextF , 0 , 0 );                          #|Add TextF to PictureF in centre position
                                                                #|
   if                                                           #|Set correct ResponseTypeF
     ResponseTypeF == "StimFirstResponse"                       #|
   then                                                         #|
     ResponseTypeF = "FirstResponse";                           #|
   end;                                                         #|
                                                                #|
   if                                                           #|
     TextStrF == "Keep"                                         #|TextStrF == "Keep"
   then                                                         #|
     TextF.set_caption(" ");                                    #|Reset marker text
   elseif                                                       #|
     TextStrF != "Keep"                                         #|TextStrF != "Keep"
   then                                                         #|
     TextF.set_caption(TextStrF);                               #|Set marker text
     TextF.set_font_size(FontSizeF);                            #|Set font size
     PictureF.set_part_y(PictureF.part_count(),yPositionF);     #|Set object position y-coordinate
   end;                                                         #|
   TextF.redraw();                                              #|Redraw text object
                                                                #|
   StimulusEvent.set_stimulus(PictureF);                        #|Set stimulus PictureF in TrialF
                                                                #|
   if                                                           #|Set timing and duration
     DurationF == 0                                             #|
   then                                                         #|
     TrialF.set_duration(forever);                              #|Await button press before continue
   else                                                         #|
     StimulusEvent.set_delta_time(0);                           #|Start immediately after last stimulus
     TrialF.set_duration(DurationF);                            #|Keep presented in DurationF ms
   end;                                                         #|
                                                                #|
   if                                                           #|Set response type
     ResponseTypeF == "FixedDuration"                           #|Case: FixedDuration
   then                                                         #|
     if                                                         #|
       DurationF == 0                                           #|
     then                                                       #|
       TrialF.set_type(first_response);                         #|Continue when button press
     elseif                                                     #|
       DurationF != 0                                           #|
     then                                                       #|
       TrialF.set_type(fixed);                                  #|Disregard button press
     end;                                                       #|
   elseif                                                       #|
     ResponseTypeF == "FirstResponse"                           #|Case: FIRST RESPONSE
   then                                                         #|
     TrialF.set_type(first_response);                           #|Continue when button press
   elseif                                                       #|
     ResponseTypeF == "CorrectResponse"                         #|Case: CORRECT RESPONSE
   then                                                         #|
     TrialF.set_type(correct_response);                         #|Continue when correct button press
   elseif                                                       #|
     ResponseTypeF.count() >= 16                                #|
   then                                                         #|
     if                                                         #|
       ResponseTypeF.substring(1,16) == "SpecificResponse"      #|Case: SpecificResponse
     then                                                       #|
       TrialF.set_terminator_button(int(                        #|Set terminator button to TargetButtonNextTrial
         ResponseTypeF.substring(17,ResponseTypeF.count()-16)));#|
       TrialF.set_type(specific_response);                      #|Continue when specific button press
     end;                                                       #|
   else                                                         #|
     TrialF.set_type(fixed);                                    #|Ignore response
   end;                                                         #|
                                                                #|
   StimulusEvent.set_event_code(EventCodeF);                    #|Set event code
                                                                #|
   if                                                           #|Set port code
     SendCodeF == true                                          #|
   then                                                         #|
     if                                                         #|
       PortCodeF == "0"   ||                                    #|
       PortCodeF == "XXX" ||                                    #|
       PortCodeF == " "                                         #|
     then                                                       #|
       StimulusEvent.set_port_code(0);                          #|Reset output port code
     elseif                                                     #|
       PortCodeF != "0"   &&                                    #|
       PortCodeF != "XXX" &&                                    #|
       PortCodeF != " "                                         #|
     then                                                       #|
       StimulusEvent.set_port_code(int(PortCodeF));             #|Update code to send over port
     end;                                                       #|
   end;                                                         #|
                                                                #|
   TrialF.present();                                            #|Present trial
                                                                #|
 end;                                                           # ---
