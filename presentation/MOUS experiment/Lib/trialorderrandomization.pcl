 #==============================================================# 
 # TRIALORDERRANDOMIZATION                                      # 
 #==============================================================# 
 # DESCRIPTION:                                                 #
 #                                                              #
 #   Generate randomized trial order array                      #
 #                                                              #
 # SYNTAX:                                                      #
 #                                                              #
 #   array<int> Out = trialorderrandomization (NumBlock,NumMax);#
 #                                                              #
 # OPTION:                                                      #
 #                                                              #
 #   int NumBlock = Number of blocks in experiment              #
 #   int NumMax   = Maximum number of trials                    #
 #                                                              #
 # EXAMPLE:                                                     #
 #                                                              #
 #   int NumBlock   = 4;                                        # Number of blocks in experiment
 #   int NumMax     = 30;                                       # Maximum number of trials
 #   array<int> Out = trialorderrandomization (NumBlock,NumMax);#
 #                                                              # 
 # DEPENDENCIES:                                                #
 #                                                              #
 #   No dependencies                                            #
 #                                                              #
 # OBJECTS:                                                     #
 #                                                              #
 #   No objects                                                 #
 #                                                              #
 # Last version 23-Oct-2008 02:59:27, Christian Forkstam        #
 #==============================================================#
 sub array <int,1> trialorderrandomization (                    # ---INPUT ARGUMENT(S)
   int NumBlockF,                                               #|Number of blocks in experiment
   int NumMaxF                                                  #|Maximum number of trials
 ) begin                                                        # ---
 if                                                             #|
   Debug                                                        #|
 then                                                           #|
   term.print("RUNNING: TRIALORDERRANDOMIZATION\n");            #|
 end;                                                           #|
 #--------------------------------------------------------------#|
                                                                #|
   array<int> Order[NumMaxF];                                   #|INTEGER ARRAY TO HOLD ORDER
   array<int> BlockOrder[NumBlockF];                            #|INTEGER ARRAY OF BLOCK SIZE TO HOLD BLOCK ORDER
                                                                #|
   loop                                                         #|Set BlockOrder = 1:BlockF
     int PosBlock = 1                                           #|
   until                                                        #|
     PosBlock > NumBlockF                                       #|
   begin                                                        #|
     BlockOrder[PosBlock] = PosBlock;                           #|
     PosBlock = PosBlock + 1;                                   #|
   end;                                                         #|
                                                                #|
   BlockOrder.shuffle();                                        #|Shuffle BlockOrder
                                                                #|
   if                                                           #|Case: MaxF < BlockF
     NumMaxF < NumBlockF                                        #|
   then                                                         #|
                                                                #|
     loop                                                       #|Set Order to sub part of BlockOrder
       int PosOrder = 1                                         #|
     until                                                      #|
       PosOrder > NumMaxF                                       #|
     begin                                                      #|
       Order[PosOrder] = BlockOrder[PosOrder];                  #|
       PosOrder = PosOrder + 1;                                 #|
     end;                                                       #|
                                                                #|
   elseif                                                       #|Case: MaxF >= BlockF
     NumMaxF >= NumBlockF                                       #|
   then                                                         #|
                                                                #|
     loop                                                       #|Set Order to shuffled BlockOrder arrays
       int PosBlock = 1;                                        #|
       int PosOrder = 1                                         #|
     until                                                      #|
       PosOrder > NumMaxF                                       #|
     begin                                                      #|
       Order[PosOrder] = BlockOrder[PosBlock];                  #|
       if                                                       #|When end of BlockOrder array
         PosBlock == NumBlockF                                  #|
       then                                                     #|
         BlockOrder.shuffle();                                  #|Shuffle BlockOrder
         PosBlock = 1;                                          #|Reset PosBlock = 1
       else                                                     #|
         PosBlock = PosBlock + 1;                               #|Or update PosBlock = PosBlock + 1
       end;                                                     #|
       PosOrder = PosOrder + 1;                                 #|Update PosOrder = PosOrder + 1
     end;                                                       #|
                                                                #|
   end;                                                         #|
                                                                #|
   return Order                                                 #|RETURN ORDER
                                                                #|
 end;                                                           #|
