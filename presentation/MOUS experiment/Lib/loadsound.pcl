 #==============================================================#
 # LOADSOUND                                                    #
 #==============================================================#
 # DESCRIPTION:                                                 #
 #                                                              #
 #   Load or unload sound in sound array Sounds                 #
 #                                                              #
 # SYNTAX:                                                      #
 #                                                              #
 #   loadsound (Load,Sound,SoundAlphabet);                      #
 #                                                              #
 # OPTION:                                                      #
 #                                                              #
 #   Load          = Load/unload sound file                     #
 #   Sound         = Sound in SoundAlphabet                     #
 #   SoundAlphabet = Sound alphabet                             #
 #                                                              #
 # EXAMPLE:                                                     #
 #                                                              #
 #   bool          Load  = true;                                # Load/unload sound file
 #   string        Sound = "M";                                 # Sound in SoundAlphabet
 #   array<string> SoundAlphabet[5] = {"M","S","V","R","X"};    # Sound alphabet (ordered as in sound object Sounds)
 #   loadsound (Load,Sound,SoundAlphabet);                      #
 #                                                              #
 # DEPENDENCIES:                                                #
 #                                                              #
 #   No dependencies                                            #
 #                                                              #
 # OBJECTS:                                                     #
 #                                                              #
 #   Sound array Sounds                                         #
 #                                                              #
 # Last version 23-Oct-2008 00:59:35, Christian Forkstam        #
 #==============================================================#
 sub loadsound (                                                # ---INPUT ARGUMENT(S)
     bool             LoadF,                                    #|Load/unload sound file
     string           SoundF,                                   #|Sound in SoundAlphabet
     array<string,1>& SoundAlphabetF                            #|Sound alphabet (ordered as in sound object Sounds)
 ) begin                                                        # ---
 if                                                             #|
   Debug                                                        #|
 then                                                           #|
   term.print("RUNNING: LOADSOUND\n");                          #|
 end;                                                           #|
 #--------------------------------------------------------------#|
                                                                #|
   bool ExistSound = false;                                     #|ERROR CHECK: SoundF
                                                                #|
   loop                                                         #|LOOP OVER ITEMS IN SOUNDALPHABET
     int  Pos = 1                                               #|
   until                                                        #|
     Pos > SoundAlphabetF.count()                               #|
   begin                                                        #|
                                                                #|
     if                                                         #|
       SoundF == SoundAlphabetF[Pos]                            #|
     then                                                       #|
       ExistSound = true;                                       #|ERROR CHECK: LoadF
       if                                                       #|
         LoadF == true                                          #|
       then                                                     #|
         Sounds[Pos].get_wavefile().load();                     #|
         return;                                                #|
       elseif                                                   #|
         LoadF == false                                         #|
       then                                                     #|
         Sounds[Pos].get_wavefile().unload();                   #|
         return;                                                #|
       else                                                     #|
         showerror("LOADSOUNDS:Wrong argument:Load");           #|ERROR CHECK: LoadF
         return;                                                #|
       end;                                                     #|
     end;                                                       #|
     Pos = Pos + 1;                                             #|
                                                                #|
   end;                                                         #|
                                                                #|
   if                                                           #|
     !ExistSound                                                #|ERROR CHECK: SoundF
   then                                                         #|
     showerror("LOADSOUNDS: Sound not defined");                #|ERROR CHECK: SoundF
     return;                                                    #|
   end;                                                         #|
                                                                #|
 end;                                                           # ---
