
#############Read text file into array ##################

 #==============================================================#
 sub array <string, 1> readfileLines (                          # ---INPUT ARGUMENT(S)
     string FileNameF                                           #|File name
 ) begin                                                        # ---
 if                                                             #|
   Debug                                                        #|
 then                                                           #|
   term.print("RUNNING: READFILE\n");                           #|
 end;                                                           #|
 #--------------------------------------------------------------#|
                                                                #|
   input_file File = new input_file;                            #|Declare new input file File
   File.open(FileNameF);                                        #|Open file FileNameF

   int p = fileLength(FileNameF);
	array <string> TextLines[p];
	
   loop
		int n = 1
	 until                                                        #|
     File.end_of_file() == true
	begin
		TextLines[n] = TextLines[n] + File.get_line() + "\n";
		n = n+1;
	end;
                                                                #|
   return TextLines;                                              #|Return string TextStr
                                                                #|
 end;                                                           # ---
