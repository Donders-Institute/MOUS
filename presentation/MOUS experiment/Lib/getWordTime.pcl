#############calculate stimulus presentation time ##################
 sub int getWordTime ( string inputWord, int soundtime, string row 
 ) begin                                                        # ---
 if                                                             #|
   Debug                                                        #|
 then                                                           #|
   term.print("RUNNING: READFILE\n");                           #|
 end;                                                           #|
 #--------------------------------------------------------------#|
                                                                #|

	string char;
	
	int punkt = row.find(".");
	
	if (punkt > 0)then 	#remove punctiation mark from the end of the entence-final before getting time.
	row = row.substring(1,punkt-1);
	row.append(" ");
	end;


   array <string> rad[1];
   row.split(" ", rad);		# Split row into array with each word	
   loop 							# Present sentence one-by-one
		int i = 4;				# Skip the first 4 columns with parameters
		until 
		i > (rad.count())
		begin
	   char.append(rad[i]);  #create a string with all words concatenated without spaces.
	   i = i+1;
	end;
	
	int numOfWords = rad.count()-5; #Skip the first 4 columns with parameters and the empty column at the end
	 
   int k = ( (soundtime - numOfWords) /char.count() ) -50 ; #koefficient time for one letter
   # (total time - (number of words) / number of letters in sentece ) - 50 ms
 	
	int x = inputWord.count();
   
   int wordTime = k*x+200;
   
   if (wordTime < 300)then 
   wordTime = 300;   
   end;
 
   return wordTime;
   
 end; 
 
 
# For visual and auditory word sequences, the presentation time y will be 
# determined by y = kx + m, where x is the number of letters in the word, 
# m is an offset of 200 ms and k is a coefficient determined trial by trial, 
# given by the auditory sentence presentation rate. If the given word time is
# less than 300 ms a minimum presentation time of 300 ms will be set. 
