 #==============================================================#
 # PRE4STRING2INT                                               #
 #==============================================================#
 # DESCRIPTION:                                                 #
 #                                                              #
 #   Transform text string to an integer string by first        #
 #   removing any initial zeroes in the string                  #
 #                                                              #
 # SYNTAX:                                                      #
 #                                                              #
 #   string IntegerString = pre4string2int (IntegerString);     #
 #                                                              #
 # OPTION:                                                      #
 #                                                              #
 #   IntegerString = Integer string                             #
 #                                                              #
 # EXAMPLE:                                                     #
 #                                                              #
 #   string IntegerString = "0001";                             #
 #   string IntegerString = pre4string2int (IntegerString);     #
 #                                                              #
 # DEPENDENCIES:                                                #
 #                                                              #
 #   No dependencies                                            #
 #                                                              #
 # OBJECTS:                                                     #
 #                                                              #
 #   No objects                                                 #
 #                                                              #
 # Last version 23-Apr-2009 12:30:01, Christian Forkstam        #
 #==============================================================#
 sub string pre4string2int(                                     # ---INPUT ARGUMENT(S)
     string IntegerString                                       #|Text string with digits
   ) begin                                                      # ---
 if                                                             #|
   Debug                                                        #|
 then                                                           #|
   term.print("RUNNING: PRE4STRING2INT\n");                     #|
 end;                                                           #|
 #--------------------------------------------------------------#|
                                                                #|
/* loop                                                         #|Check that input string is only composed if digits
     int Pos                                                    #|
   until                                                        #|
     Pos > IntegerString.count()                                #|
   begin                                                        #|
     if                                                         #|
       IntegerString.substring(Pos,1) != "0" &&                 #|
       IntegerString.substring(Pos,1) != "1" &&                 #|
       IntegerString.substring(Pos,1) != "2" &&                 #|
       IntegerString.substring(Pos,1) != "3" &&                 #|
       IntegerString.substring(Pos,1) != "4" &&                 #|
       IntegerString.substring(Pos,1) != "5" &&                 #|
       IntegerString.substring(Pos,1) != "6" &&                 #|
       IntegerString.substring(Pos,1) != "7" &&                 #|
       IntegerString.substring(Pos,1) != "8" &&                 #|
       IntegerString.substring(Pos,1) != "9"                    #|
     then                                                       #|
       showerror("Check integer string for non-digit element!");#|
       return IntegerString;                                    #|
     end;                                                       #|
     Pos = Pos + 1;                                             #|
   end;                                                         #|
*/                                                              #|
   loop                                                         #|Check position of first non-zero element and update Integer
     int Pos                                                    #|
   until                                                        #|
     Pos > IntegerString.count()                                #|
   begin                                                        #|
     if                                                         #|
       IntegerString.substring(Pos,1) != "0"                    #|
     then                                                       #|
       IntegerString = IntegerString.substring(Pos,             #|
                         IntegerString.count()-(Pos-1));        #|
       return IntegerString;                                    #|
     end;                                                       #|
     Pos = Pos + 1;                                             #|
   end;                                                         #|
                                                                #|
   return IntegerString;                                        #|
                                                                #|
 end;                                                           # ---
