 #==============================================================#
 # GETPICTURE                                                   #
 #==============================================================#
 # DESCRIPTION:                                                 #
 #                                                              #
 #   Get Picture object                                         #
 #                                                              #
 # SYNTAX:                                                      #
 #                                                              #
 #   picture Out = getpicture (Picture)                         #
 #                                                              #
 # OPTION:                                                      #
 #                                                              #
 #   picture Picture = Picture object Picture                   #
 #                                                              #
 # EXAMPLE:                                                     #
 #                                                              #
 #   picture Out = getpicture (Picture)                         # Copy picture object Picture to Out
 #                                                              #
 # DEPENDENCIES:                                                #
 #                                                              #
 #   No dependencies                                            #
 #                                                              #
 # OBJECTS:                                                     #
 #                                                              #
 #   Text object Bar                                            #
 #   Picture object Picture                                     #
 #   Global variable Modality                                   #
 #   Global variable FixationBars                               #
 #                                                              #
 # Last version 23-Oct-2008 00:36:24, Christian Forkstam        #
 #==============================================================#
 sub picture getpicture (                                       # ---INPUT ARGUMENT(S)
     picture PictureF                                           #|Picture object Picture
 ) begin                                                        # ---
 if                                                             #|
   Debug                                                        #|
 then                                                           #|
   term.print("RUNNING: GETPICTURE\n");                         #|
 end;                                                           #|
 #--------------------------------------------------------------#|
                                                                #|
   PictureF.clear();                                            #|Clear Picture
                                                                #|
    
                                                                #|
   return PictureF;                                             #|Return Picture
                                                                #|
 end;                                                           # ---
