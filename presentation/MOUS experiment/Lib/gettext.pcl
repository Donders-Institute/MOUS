 #==============================================================#
 # GETTEXT                                                      #
 #==============================================================#
 # DESCRIPTION:                                                 #
 #                                                              #
 #   Get text object Text                                       #
 #                                                              #
 # SYNTAX:                                                      #
 #                                                              #
 #   text Out = gettext (Text);                                 #
 #                                                              #
 # OPTION:                                                      #
 #                                                              #
 #   Text = Text object Text                                    #
 #                                                              #
 # EXAMPLE:                                                     #
 #                                                              #
 #   text Out = gettext (Text);                                 # Copy text object Text to Out
 #                                                              #
 # DEPENDENCIES:                                                #
 #                                                              #
 #   Text object font TextFont                                  #
 #   Text object color TextColor                                #
 #                                                              #
 # OBJECTS:                                                     #
 #                                                              #
 #   Text object Text                                           #
 #                                                              #
 # Last update 13-Mar-2009 00:18:00, Christian Forkstam         #
 # * Updated to handle specific font for selected items         #
 # Last version 05-Nov-2008 13:29:16, Christian Forkstam        #
 #==============================================================#
 sub text gettext (                                             # ---INPUT ARGUMENT(S)
     text TextF                                                 #|Text object Text
 ) begin                                                        # ---
 if                                                             #|
   Debug                                                        #|
 then                                                           #|
   term.print("RUNNING: GETTEXT\n");                            #|
 end;                                                           #|
 #--------------------------------------------------------------#|
                                                                #|
   TextF.set_caption(" ");                                      #|Reset Text object caption
   TextF.set_font(TextFont);                                    #|Reset Text object caption
   TextF.set_font_color(TextColor[1],TextColor[2],TextColor[3]);#|Reset Text object color
   TextF.redraw();                                              #|Redraw Text object
   return TextF;                                                #|Return Text
                                                                #|
 end;                                                           # ---
