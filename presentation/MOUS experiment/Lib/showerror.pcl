 #==============================================================#
 # SHOWERROR                                                    #
 #==============================================================#
 # DESCRIPTION:                                                 #
 #                                                              #
 #   Display error message                                      #
 #                                                              #
 # SYNTAX:                                                      #
 #                                                              #
 #   showerror (ErrorMessage);                                  #
 #                                                              #
 # OPTION:                                                      #
 #                                                              #
 #   ErrorMessage = Error message                               #
 #                                                              #
 # EXAMPLE:                                                     #
 #                                                              #
 #   ErrorMessage = "Error this or that";                       # Error message
 #   showerror (ErrorMessage);                                  #
 #                                                              #
 # DEPENDENCIES:                                                #
 #                                                              #
 #   GETTEXT                                                    #
 #   GETPICTURE                                                 #
 #   GETTRIAL                                                   #
 #                                                              #
 # OBJECTS:                                                     #
 #                                                              #
 #   Text object Text                                           #
 #   Picture object Picture                                     #
 #   Trial object Trial                                         #
 #                                                              #
 # Last version 23-Oct-2008 02:56:42, Christian Forkstam        #
 #==============================================================#
 sub showerror (                                                # ---INPUT ARGUMENT(S)
     string ErrorMessageF                                       #|Error message
 ) begin                                                        # ---
 if                                                             #|
   Debug                                                        #|
 then                                                           #|
   term.print("RUNNING: SHOWERROR\n");                          #|
 end;                                                           #|
 #--------------------------------------------------------------#|
                                                                #|
   text TextF = gettext(Texts[1]);                              #|Get text object Texts[1]
   TextF.set_caption("Error:\n"+ErrorMessageF);                 #|Set error message
   TextF.set_font_size(15);                                     #|Set font
   TextF.set_font_color(255,0,0);                               #|Set red text colour
   TextF.redraw();                                              #|
                                                                #|
   picture PictureF = getpicture(Picture);                      #|Get picture object Picture
   PictureF.clear();                                            #|Clear picture parts
   PictureF.add_part( TextF , 0 , 0 );                          #|Add picture part in center position
                                                                #|
   trial TrialF = gettrial(Trial);                              #|Get trial Trial
   TrialF.set_type(fixed);                                      #|Ignore response
   TrialF.set_duration(1000);                                   #|Set duration to 1 second
   StimulusEvent.set_stimulus(PictureF);                        #|Set PictureF as stimulus in StimulusEvent
   TrialF.present();                                            #|Present error message for 1 second
                                                                #|
 end;                                                           # ---
