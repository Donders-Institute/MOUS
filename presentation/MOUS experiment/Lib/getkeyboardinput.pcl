 #==============================================================#
 # GETKEYBOARDINPUT                                             #
 #==============================================================#
 # DESCRIPTION:                                                 #
 #                                                              #
 #   Collect input from keyboard                                #
 #                                                              #
 # SYNTAX:                                                      #
 #                                                              #
 #   getkeyboardinput (Instr,InstrFontSize,InstrPos,            #
 #                     StimFontSize,StimPos,ButtonCodes);       #
 #                                                              #
 # OPTION:                                                      #
 #                                                              #
 #   Instr         = Instruction text                           #
 #   InstrFontSize = Instruction font size                      #
 #   InstrPos      = Instruction y-position coordinate          #
 #   StimFontSize  = Stimuli font size                          #
 #   StimPos       = Stimuli y-position coordinate              #
 #   ButtonCodes   = Button codes { ... , ERASE KEY, STOP KEY}  #
 #                                                              #
 # EXAMPLE:                                                     #
 #                                                              #
 #   NB! Requires 30 response buttons                           #
 #       Experiment Input Devices: {LEFT,RIGHT,A:Z,ERASE,STOP}  #
 #       Scenario file:                                         #
 #         active_buttons = 30;                                 #
 #         button_codes   = 1,2,3,...,28,29,30;                 #
 #                                                              #
 #   string Instr      = "Retype text";                         #
 #   int InstrFontSize = 30;                                    #
 #   int InstrPos      = 150;                                   #
 #   int StimFontSize  = 60;                                    #
 #   int StimPos       = 0;                                     #
 #   array<string> ButtonCodes = {29,30};                       #
 #   getkeyboardinput (Instr,InstrFontSize,InstrPos,            #
 #                     StimFontSize,StimPos,ButtonCodes);       #
 #                                                              #
 # DEPENDENCIES:                                                #
 #                                                              #
 #     GETTEXT                                                  #
 #     GETPICTURE                                               #
 #     GETTRIAL                                                 #
 #                                                              #
 # OBJECTS:                                                     #
 #                                                              #
 #     Text object Text                                         #
 #     Picture object Picture                                   #
 #     Trial object Trial                                       #
 #                                                              #
 # Last version 23-Oct-2008 00:03:22, Christian Forkstam        #
 #==============================================================#
 sub string getkeyboardinput (                                  # ---INPUT ARGUMENT(S)
     string        RespInstrF,                                  #|Instruction text
     int           RespInstrFontSizeF,                          #|Instruction font size
     int           RespInstrPosF,                               #|Instruction position
     int           StimFontSizeF,                               #|Stimuli font size
     int           StimPosF,                                    #|Stimuli position
     array<int,1>& ButtonCodesF                                 #|Button codes
 ) begin                                                        # ---
 if                                                             #|
   Debug                                                        #|
 then                                                           #|
   term.print("RUNNING: GETKEYBOARDINPUT\n");                   #|
 end;                                                           #|
 #--------------------------------------------------------------#|
                                                                #|
   int Erase   = ButtonCodesF[ButtonCodesF.count()-1];          #|Sets integer Erase to last-1 button code
   int StopKey = ButtonCodesF[ButtonCodesF.count()];            #|Sets integer StopKey to last button code
                                                                #|
   text InstrF = gettext(Texts[1]);                             #|Assign text object Texts[1] to InstrF
   InstrF.set_caption(RespInstrF);                              #|Set InstrF text
   InstrF.set_font_size(RespInstrFontSizeF);                    #|Set InstrF font size
   InstrF.set_font_color(255,0,0);                              #|Set InstrF font color
   InstrF.redraw();                                             #|Update InstrF object
                                                                #|
   text TextF = gettext(Texts[2]);                              #|Assign text object Texts[2] to TextF
   TextF.set_font_size(StimFontSizeF);                          #|Set TestF font size
                                                                #|
   picture PictureF = getpicture(Picture);                      #|Get picture object Picture
   PictureF.add_part( InstrF , 0 , RespInstrPosF );             #|Add text object InstrF to picture object PictureF in RespInstrPosF y position
   PictureF.add_part( TextF  , 0 , StimPosF      );             #|Add text object TextF to picture object PictureF in StimPosF y position
                                                                #|
   trial TrialF = gettrial(Trial);                              #|Get trial Trial
   StimulusEvent.set_stimulus(PictureF);                        #|Set PictureF as stimulus in StimulusEvent
   TrialF.set_duration(stimuli_length);                         #|Await button press before continue
                                                                #|
   string Response = " ";                                       #|Declare string Response
   int    LastKey  = ' ';                                       #|Declare int LastKey
   int    Pos      = 1;                                         #|Assign int Pos = 1
   system_keyboard.set_max_length(1);                           #|Set number of keyboard key press to 1
                                                                #|
   loop                                                         #|Loop until StopKey key press
   until                                                        #|
     LastKey == StopKey                                         #|
   begin                                                        #|
                                                                #|
     TextF.set_caption(Response);                               #|Set text in TextF to Response
     TextF.redraw();                                            #|Update TextF
     StimulusEvent.set_event_code(Response);                    #|Set event code
     TrialF.present();                                          #|Echo response on screen
                                                                #|
     system_keyboard.get_input();                               #|Get subject input
     LastKey = response_manager.last_response();                #|Store button_code of last input in LastKey
                                                                #|
 #---CASE: Other key presses than StopKey-----------------------#|
     if                                                         #|
       LastKey != StopKey                                       #|
     then                                                       #|
 #---CASE: If last input is Erase, erase one character----------#|
       if                                                       #|
         LastKey == Erase                                       #|
       then                                                     #|
         if                                                     #|
           Pos == 2                                             #|
         then                                                   #|
           Response = " ";                                      #|
           Pos = 1;                                             #|
         elseif                                                 #|
           Pos > 2                                              #|
         then                                                   #|
           Response = Response.substring(1,Pos-2);              #|
           Pos = Pos - 1;                                       #|
         end;                                                   #|
 #---CASE: Other key presses than Erase or StopKey--------------#|
       else                                                     #|
         LastKey = LastKey + 62;                                #|Update LastKey to equivalent ASCII letter number
         if                                                     #|Add space to Response if in position > 1
           Pos > 1                                              #|
         then                                                   #|
           Response = Response + " ";                           #|
         end;                                                   #|
         Response.set_char(Pos,LastKey);                        #|Set last position in Response to last input letter
         Pos = Pos + 1;                                         #|Update Pos
       end;                                                     #|
     end;                                                       #|
                                                                #|
   end;                                                         #|
                                                                #|
   StimulusEvent.set_event_code(Response);                      #|Update event code to subject response
   TrialF.present();                                            #|Echo to log file
                                                                #|
   return Response;                                             #|Return Response
                                                                #|
 end;                                                           # ---
