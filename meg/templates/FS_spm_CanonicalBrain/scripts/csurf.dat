#!csurf0.9datfile
csurf arrayname: convparms
aligntype noalign
csurf arrayname: stripskullparms
seed,k none surf 0 thresh default seed,i none algo {} preflood default seed,j none more 0 less 0
csurf arrayname: normalizeparms
intensgradlim default manualcontrol 0 normsteps default
csurf arrayname: wmfilterparms
wm_hi default wm_low default keepedits 0 gray_hi default
csurf arrayname: wmfillparms
callx 0.0 ponsx 0.0 cally 0.0 ponsy 0.0 max_same_neigh 1 ccmask 1 callz 0.0 callpnt 0 ponsz 0.0 ponspnt 0
csurf arrayname: inflateparms
metric2smooth 0.1 smoothcycles 10 inflatecycles 10
csurf arrayname: finalparms

csurf arrayname: flattenparms
sampledist_mm_full 7 vertices_per_full 12 sampledist_mm_patch 20 vertices_per_patch 12 write_per_iters 0
csurf arrayname: sphereparms
write_per_iters 0 sampledist_mm 7 vertices_per 8
